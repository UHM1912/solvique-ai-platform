# Keep the Cloud Build upload context focused on the backend source and assets.
.gcloudignore
.git/
.gitignore

# Environment files and credentials
.env
.env.*
*.env
*.env.*
**/.env
**/.env.*
**/*.env
**/*.env.*
**/credentials/
**/*credential*.json
**/*service_account*.json
**/*service-account*.json
**/application_default_credentials.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.ppk
**/id_rsa
**/id_ed25519

# Python environments, caches, test output, and build artifacts
.venv/
venv/
env/
**/.venv/
**/venv/
**/__pycache__/
*.py[cod]
*.pyo
.pytest*/
**/.pytest*/
.ruff_cache/
**/.ruff_cache/
.mypy_cache/
**/.mypy_cache/
.benchmarks/
**/.benchmarks/
.coverage
.coverage.*
htmlcov/
tests/
**/tests/
test_*.py
**/test_*.py
build/
dist/
*.egg-info/
**/*.egg-info/

# Local state, temporary files, and logs
**/*.db
**/*.sqlite
**/*.sqlite3
**/*.db-*
**/*.sqlite-*
data/report_assets/
data/conversations/
data/rag_sources/
src/rag_tool_utils/chunks/
src/sql_tool_utils/internal_doc_chunks/
.tmp/
tmp/
temp/
**/*.tmp
**/*.temp
logs/
**/logs/
**/*.log
history.json

# Editors and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db

