# ==============================================================================
# Solvique Backend — Environment Configuration Template
# ==============================================================================

# Google Gemini API Key (Required for LLM orchestration & embeddings)
# Obtain from https://aistudio.google.com/
GOOGLE_API_KEY=""

# Google Cloud Platform / BigQuery Configuration
# For local development, authenticate via: gcloud auth application-default login
big_query_project_id="solvique-personal"
big_query_dataset="ecommerce"

# Optional: Tavily API Key for live web search augmentation
# Obtain from https://tavily.com/
TAVILY_API_KEY=""

# Application Data Directory (Path to conversation DB and report assets)
# Project-relative default is ./data. Legacy UQE_DATA_DIR remains supported.
SOLVIQUE_DATA_DIR="./data"

# Storage backends: local development defaults; set postgres and gcs for Cloud Run.
STORAGE_BACKEND="sqlite"
REPORT_ASSET_BACKEND="local"

# PostgreSQL settings. DATABASE_URL may be used instead of the individual fields.
# For Cloud Run with an attached Cloud SQL instance, set CLOUD_SQL_CONNECTION_NAME
# to PROJECT:REGION:INSTANCE and configure the service's Cloud SQL connection.
# The service identity needs Cloud SQL Client; DB_USER needs CONNECT, schema USAGE,
# and CREATE for first-run schema initialization (or use a separate migration role).
# CLOUD_SQL_CONNECTION_NAME="project:region:instance"
# DB_NAME="solvique"
# DB_USER="solvique_app"
# DB_PASSWORD=""
# DB_POOL_MIN_SIZE="1"
# DB_POOL_MAX_SIZE="5"
# DB_CONNECT_TIMEOUT="10"

# Private GCS bucket for generated report images. Grant the Cloud Run service
# identity object create/read/delete access (for example, Storage Object User).
# GCS_BUCKET_NAME="solvique-report-assets"

# Application Logging
LOG_FILE_PATH="./logs/app.log"
